# Copy to server/.env for local development. Never commit server/.env.
# In production, set these in your hosting platform's secret manager instead.

# --- SMTP (values come from your email provider; placeholders only) ---
SMTP_HOST=
# 587 = STARTTLS submission (SMTP_SECURE=false). 465 = implicit TLS (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
# With SMTP_SECURE=false the connection must upgrade via STARTTLS (default true).
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

# Fixed sender: an address your SMTP account is allowed to send as.
# Example format: Portfolio Contact <you@yourdomain.com>
MAIL_FROM=
# Where inquiries are delivered.
MAIL_TO=vinodvinni308@gmail.com

# --- Server ---
PORT=3001
# Frontend origin(s) allowed to call the API, comma-separated, no trailing slash.
CLIENT_ORIGIN=http://localhost:5173
# Set when running behind a reverse proxy / load balancer (e.g. 1 for one hop)
# so rate limiting sees the real client IP. Leave unset when not behind a proxy.
TRUST_PROXY=
# Contact form limit per IP.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=15
# true = also serve the built frontend from ../dist (single-service deploys).
SERVE_STATIC=false
# Check SMTP login at startup (logs result only).
SMTP_VERIFY_ON_START=true

# Local development without SMTP credentials: MAIL_TRANSPORT=log records that a
# message *would* be sent (metadata only) instead of sending. Refused in production.
MAIL_TRANSPORT=smtp
