# Hostinger (LiteSpeed/Apache) only; other hosts ignore this file.

# Unknown URLs get the site's own 404 page (noindex), with a 404 status.
ErrorDocument 404 /404.html

# llms.txt, llms-full.txt and sitemap.xml contain non-ASCII text (é, →).
AddDefaultCharset UTF-8
AddType "text/plain; charset=utf-8" .txt
AddType "application/xml; charset=utf-8" .xml

# Keep /admin out of search engines and AI crawlers (the page also has a
# noindex meta tag).
<IfModule mod_setenvif.c>
  <IfModule mod_headers.c>
    SetEnvIf Request_URI "^/admin" ADMIN_PAGE
    Header set X-Robots-Tag "noindex, nofollow" env=ADMIN_PAGE
  </IfModule>
</IfModule>

# One canonical host: www.vinod-kumar.in -> vinod-kumar.in
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>
